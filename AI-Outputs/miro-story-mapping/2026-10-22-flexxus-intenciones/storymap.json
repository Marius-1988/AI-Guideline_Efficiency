{
  "title": "Flexxus: de pantallas a intenciones (roles Vendedor y Administrativo)",
  "subtitle": "Story Mapping",
  "product": "Flexxus ERP",
  "board_name": "Flexxus ERP — Story Mapping",
  "mvp": "El MVP es la intención «Vender en mostrador» del rol Vendedor: al iniciar sesión, el vendedor entra a su propia pantalla principal, desde la que busca, arma, cobra y emite la venta (factura, pedido o presupuesto) con todas las reglas de precio, stock y cuenta corriente del core, sin ver el menú del ERP; todavía no gestiona lo que otros generaron ni cubre otras intenciones (viajante, depósito, consulta pura).",
  "epics": [
    {
      "code": "ROL",
      "name": "Experiencia por rol: entrada y navegación"
    },
    {
      "code": "VEN",
      "name": "Intención «Vender en mostrador»"
    },
    {
      "code": "ADM",
      "name": "Intención «Gestionar y cerrar la venta»"
    }
  ],
  "objetivos": [
    "OBJ-1 Roles Vendedor y Administrativo definidos: permisos, vistas, funcionalidades y regla de asignación",
    "OBJ-2 Experiencia objetivo del Vendedor: inicio (dashboard), flujo principal y alternativos",
    "OBJ-3 Experiencia objetivo del Administrativo: inicio, menú acotado y flujos principales",
    "OBJ-4 Capacidades del core y datos que requiere la experiencia, con su disponibilidad",
    "OBJ-5 Catálogo de intenciones priorizado para el roadmap",
    "OBJ-6 Equivalencia funcional del flujo del Vendedor con el comportamiento vigente"
  ],
